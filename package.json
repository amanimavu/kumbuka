{
  "name": "kumbuka",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "start:app": "nx serve kumbuka-app",
    "start:portal": "nx serve kumbuka-portal",
    "start:website": "nx serve kumbuka-website",
    "start:all": "concurrently \"pnpm start:app\" \"pnpm start:portal\" \"pnpm start:website\"",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "serve:ssr:kumbuka-app": "node dist/kumbuka-app/server/server.mjs",
    "serve:ssr:kumbuka-portal": "node dist/kumbuka-portal/server/server.mjs",
    "serve:ssr:kumbuka-website": "node dist/kumbuka-website/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.14",
    "@primeuix/themes": "^2.0.3",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.8",
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@nx/angular": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@schematics/angular": "^21.2.8",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^8.2.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "nx": "23.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}